# Copy to .env and fill in real values. Never commit .env.
APP_NAME=RAG Document Q&A
LOG_LEVEL=INFO

# ---- LLM answer generation ----------------------------------------------
# Google Gemini (free tier). Get a key at https://aistudio.google.com/apikey
# Leave empty to run in "passage mode" (shows the most relevant passages
# instead of a written answer).
GEMINI_API_KEY=
# Optional: any current Gemini model, e.g. gemini-3.8-flash (smarter, lower
# free quota) or gemini-3.5-flash-lite (default, higher free quota).
GEMINI_MODEL=gemini-3.5-flash-lite

# Advanced: any other OpenAI-compatible API (OpenAI, Groq, local Ollama).
# Only used when GEMINI_API_KEY is empty.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Storage, relative to project root
DOCUMENTS_DIR=data/documents
CHROMA_DIR=chroma_db

# Retrieval tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MAX_UPLOAD_MB=25
